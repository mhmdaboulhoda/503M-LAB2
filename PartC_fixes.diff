+def _reencode_if_image(attached, filename):
+    """Part C Layer-2 fix: content-based type check for images.
+
+    If the extension says this is an image we accept, prove it by decoding the
+    bytes with Pillow and re-encoding them. Only real raster data survives, so a
+    script smuggled into the file is destroyed. Returns a new file object to
+    store; raises ValidationError if the bytes are not a valid image. Non-image
+    attachments are returned unchanged (the extension allowlist already gates
+    them, and we do not re-encode documents).
+    """
+    import io
+    import os
+
+    from django.core.exceptions import ValidationError
+    from django.core.files.base import ContentFile
+
+    image_exts = {".jpg": "JPEG", ".jpeg": "JPEG", ".png": "PNG"}
+    ext = os.path.splitext(os.path.basename(filename))[1].lower()
+    fmt = image_exts.get(ext)
+    if not fmt:
+        return attached
+
+    try:
+        from PIL import Image
+
+        attached.seek(0)
+        with Image.open(attached) as img:
+            img.load()
+            if fmt == "JPEG" and img.mode in ("RGBA", "P"):
+                img = img.convert("RGB")
+            buf = io.BytesIO()
+            img.save(buf, format=fmt)
+    except ValidationError:
+        raise
+    except Exception:
+        raise ValidationError(
+            "Attachment %(name)s is not a valid image." % {"name": filename}
+        )
+
+    return ContentFile(buf.getvalue(), name=os.path.basename(filename))
+
+
