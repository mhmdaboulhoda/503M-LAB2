diff --git a/lab/nginx.conf b/lab/nginx.conf
index 6ce0162..3355b37 100644
--- a/lab/nginx.conf
+++ b/lab/nginx.conf
@@ -10,8 +10,25 @@ server {
     # Edge size limit, layered with the application's own upload check.
     client_max_body_size 10m;
 
-    location /media/ {
-        alias /srv/media/;
+    # Layer 1 fix (Part C): make the upload directory inert.
+    #   ^~  wins at step 2 of nginx's location precedence and STOPS before the
+    #       server-wide `~ \.php$` regex is ever consulted, so an uploaded
+    #       /media/.../shell.php is served as bytes, never handed to PHP (kills B1).
+    #   types { } + default_type application/octet-stream  empties the
+    #       extension->MIME table and labels every file an opaque blob, so an
+    #       .html is no longer text/html and an .svg no longer image/svg+xml;
+    #       the browser picks no parser (kills B2). Both lines are needed: default_type
+    #       only applies when nginx cannot infer a type.
+    #   Content-Disposition: attachment  the browser saves instead of rendering.
+    #   X-Content-Type-Options: nosniff  stops the browser overruling the type by
+    #       sniffing the bytes. The three MIME lines only work together.
+    #   `always`  applies the headers to error responses too.
+    location ^~ /media/ {
+        root /srv;
+        types { }
+        default_type application/octet-stream;
+        add_header Content-Disposition "attachment" always;
+        add_header X-Content-Type-Options "nosniff" always;
         autoindex off;
     }
 
