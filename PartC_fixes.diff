+def _server_generated_name(filename):
+    """Part C Layer-2 fix: choose the stored name ourselves.
+
+    The sender's filename is display text only - never a path. We store the
+    bytes under a random token plus the (allowlisted, lower-cased) extension, so
+    a name like ``../../etc/cron.d/evil`` or ``shell.php`` can neither decide
+    where the file lands nor what it is called. The original name is still kept,
+    but only as a label in the ``filename`` column, never as a path.
+    """
+    import os
+    import secrets
+
+    ext = os.path.splitext(os.path.basename(filename))[1].lower()
+    return secrets.token_hex(16) + ext
+
+
 class Attachment(models.Model):
